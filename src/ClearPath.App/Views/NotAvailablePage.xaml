<Page x:Class="ClearPath.App.Views.NotAvailablePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Not available">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding ModuleName}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="18" FontWeight="SemiBold"
                               Text="Not available in this version" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0" Text="{Binding Description}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,10,0,0"
                               Text="It is planned for a later phase. Nothing on this page scans, changes or reports anything." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
