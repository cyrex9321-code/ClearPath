<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Design tokens: spacing, radius, typography. Colours come from the WPF-UI theme brushes so light/dark stay consistent. -->

    <!-- Spacing scale -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>

    <Thickness x:Key="Pad.Page">32,24,32,32</Thickness>
    <Thickness x:Key="Pad.Card">20,16,20,16</Thickness>
    <Thickness x:Key="Margin.Section">0,24,0,12</Thickness>
    <Thickness x:Key="Margin.Card">0,0,0,12</Thickness>

    <!-- Corner radius -->
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>

    <!-- Typography -->
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Section">18</sys:Double>
    <sys:Double x:Key="FontSize.Title">28</sys:Double>
    <sys:Double x:Key="FontSize.Stat">26</sys:Double>
</ResourceDictionary>
